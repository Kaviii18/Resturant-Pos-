PORT=5000
NODE_ENV=development

# MySQL Database
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=restaurant_pos
MYSQL_PORT=3306

# JWT
JWT_SECRET=super_secret_key_restaurant_pos_2024
JWT_EXPIRES_IN=8h

# Rate Limiting (dev/LAN: dashboard GET polls are auto-excluded in server.js)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
RATE_LIMIT_DATA_MAX=5000
RATE_LIMIT_RELAXED=true

# Silent printing (Windows — uses default system printer)
# PRINTER_NAME=Your-Thermal-Printer-Name
PRINT_SILENT=true
PRINT_COPIES=1
# KEEP_PRINT_PDFS=true
